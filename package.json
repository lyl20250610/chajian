{
  "name": "dsh-ui-video-background",
  "version": "0.2.0",
  "description": "给 DSH（DeepSeek Harness）界面铺一段本地视频当动态背景，并把面板做成液态玻璃：宿主注入首屏 <video> 层，用 color-mix 把大面板令牌改半透明，脚本按结构给半透明面板挂 backdrop-blur + 高光边缘，亮/暗主题各自适配，改配置刷新即生效。",
  "type": "module",
  "main": "./lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyl20250610/chajian.git"
  },
  "author": "lyl20250610",
  "homepage": "https://github.com/lyl20250610/chajian#readme",
  "bugs": {
    "url": "https://github.com/lyl20250610/chajian/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./assets/background.mp4": "./assets/background.mp4",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "background",
    "video",
    "theme",
    "web-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
